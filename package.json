{
  "name": "immersigration",
  "version": "1.0.0",
  "description": "A minimalist WordPress theme integrated with Vite for modern web development with SCSS and JavaScript bundling.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node watch-scss.js\"",
    "build": "vite build",
    "build-scss": "npx sass app/scss/style.scss style.css --no-source-map && npx sass app/scss/style.scss style.min.css --style=compressed --source-map",
    "build-js": "node build-js.js",
    "watch-scss": "node watch-scss.js"
  },
  "keywords": [
    "wordpress",
    "theme",
    "vite",
    "scss",
    "javascript",
    "webxr",
    "immersigration"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "cesium": "^1.130.0",
    "chokidar": "^3.5.3",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "sass": "^1.83.1",
    "terser": "^5.37.0",
    "vite": "^6.0.7",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-live-reload": "^3.0.4",
    "ws": "^8.16.0"
  },
  "dependencies": {
    "isotope-layout": "^3.0.6",
    "jquery": "^3.7.1",
    "masonry-layout": "^4.2.2"
  }
}
