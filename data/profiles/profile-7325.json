{"id":7325,"profile":{"ID":7339,"title":"Felix Zhang","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/felix-zhang\/","slug":"felix-zhang","parent":"7302","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"inperson","notes":"","classes":[""],"post":{"ID":7325,"post_author":"1","post_date":"2023-12-22 17:07:53","post_date_gmt":"2023-12-22 17:07:53","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EFelix, an indie game developer and an active member of the WebXR community, has made significant contributions to the field. His standout creation, \"Elysian,\" is a WebXR wave shooter experience featuring a multiplayer mode. Launched earlier this year, it quickly became a sensation, boasting a monthly active user base of over 103,000 as of December 31, 2023. Elysian is not only one of the most popular WebXR experiences to date, but also a testament to Felix's skill in crafting engaging, complex game mechanics and polished content.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EBeyond \"Elysian,\" Felix's impact to the WebXR community extends to his role as a software engineer at Meta Reality Labs, where he developed the Immersive Web Emulator. This tool has become indispensable in the WebXR developer community, with over 6,000 active users across Chrome and Edge extension stores. Endorsed by the W3C Immersive Web Working Group, it's heralded as the go-to tool for WebXR development.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EFelix's commitment to the community is further exemplified by his contributions to the organization of significant events, such as the WebXR Mixed Reality Hackathon in November 2023 and the Presence Platform Hackathon earlier in May, where he played a key role in the WebXR portion. His efforts have not only advanced the field but also fostered a collaborative and innovative environment for peers and enthusiasts alike.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Felix Zhang","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"felix-zhang","to_ping":"","pinged":"","post_modified":"2024-03-24 20:00:28","post_modified_gmt":"2024-03-24 20:00:28","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=7325","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1713015688:1"],"_edit_last":["1"],"suppress_profile_page":["0"],"PhD":["0"],"video_aspect":["hd"],"timezone":["-7| PDT"],"_yoast_wpseo_primary_category":[""],"_yoast_wpseo_estimated-reading-time-minutes":["2"],"_yoast_wpseo_wordproof_timestamp":[""],"_yoast_wpseo_content_score":["60"],"_thumbnail_id":["7761"],"profile_title":["Immersive Web Engineer"],"email":["fe1ix@meta.com"],"sort_name":["Zhang, Felix"],"company":["Meta Reality Labs"],"linkedin":["https:\/\/www.linkedin.com\/in\/felixtrz\/"],"twitter":["https:\/\/twitter.com\/felix_trz"],"github":["https:\/\/github.com\/felixtrz"],"instagram":["https:\/\/www.instagram.com\/felixz.xr\/"],"website":["https:\/\/fez.bio"],"is_company":["0"],"logo_3D":["8067"],"discord":["felixtrz"],"bsky":["https:\/\/bsky.app\/profile\/fez.bsky.social"]},"thumbnail":false,"children":[]},"company":"Meta Reality Labs","profile_title":"Immersive Web Engineer","sort":"Zhang, Felix","slug":"felix-zhang","events":[{"event_id":7298,"event_slug":"the-4th-polys-virtual-red-carpet","event_key":"virtual-red-carpet-4","event_title":"The 4th Polys \u2013 Virtual Red Carpet","session_id":7301,"session_key":7302,"session_title":"Felix Zhang","session_slug":"p4vrc-felix-zhang","session_embed_video_ur