ost_content":"","post_title":"Big Rock Creative","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"big-rock-creative","to_ping":"","pinged":"","post_modified":"2024-01-26 22:01:14","post_modified_gmt":"2024-01-26 22:01:14","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=7632","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1706306499:1"],"_thumbnail_id":["7633"],"_edit_last":["1"],"suppress_profile_page":["0"],"PhD":["0"],"company":["Big Rock Creative"],"website":["https:\/\/bigrockxr.com\/"],"video_aspect":["hd"],"timezone":["-7| PDT"],"_yoast_wpseo_primary_category":[""],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"_yoast_wpseo_wordproof_timestamp":[""],"is_company":["0"],"linkedin":["https:\/\/www.linkedin.com\/company\/big-rock-creative-brcvr\/"],"twitter":["https:\/\/twitter.com\/BRCvr"]},"thumbnail":false,"children":{"7716":{"ID":7716,"title":"Doug Jacobson","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/doug-jacobson\/","slug":"doug-jacobson","parent":"7714","coords":"","offset":"","confirmation_status":"needs-invite","event_length_seconds":"","point_of_contact":"","guest_type":"nominee","event_type":"","appearance_type":"liveremote","notes":"","classes":[""],"post":{"ID":2573,"post_author":"1","post_date":"2022-02-03 17:45:13","post_date_gmt":"2022-02-03 17:45:13","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDoug is a co-founder of Big Rock Creative, a XR company producing large\u003Cbr\u003Escale events in VR. Big Rock\u2019s first large project, BRCvr, created a fully\u003Cbr\u003Eimmersive Burning Man festival in social VR starting in 2020 which generated\u003Cbr\u003Emuch positive PR including an article in Wired Magazine. Big Rock Creative\u003Cbr\u003Ewon the Producer's Guild innovation award and the Aurea Award. He has\u003Cbr\u003Esince worked on projects ranging from directing an XR music video featuring\u003Cbr\u003EPitbull, facilitating a Hollywood red carpet premiere in VR or creative directing\u003Cbr\u003Ethe VR version of \"Breonna's Garden\" that premiered in SXSW 2022.\u003Cbr\u003EDoug\u2019s background is in the film industry, he graduated from USC film school\u003Cbr\u003Ein the 90s with honors. Over the course of his career, he has written,\u003Cbr\u003Edirected, produced, and edited several festival award-winning narratives and\u003Cbr\u003Edocumentaries. His most notorious documentary features the Burning Man\u003Cbr\u003Efestival called, \u201cJourney to the flames\u201d which has been screened nationally\u003Cbr\u003Eand internationally. Some other feature-length docs include \u201cFaire: An\u003Cbr\u003EAmerican Renaissance\u201d and \u201cThe Secret Lives of Adult Stars\u201d, and co-edited\u003Cbr\u003Ethe award-winning short doc \u201cSelling Lies\u201d.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Doug Jacobson","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"doug-jacobson","to_ping":"","pinged":"","post_modified":"2022-11-29 23:14:59","post_modified_gmt":"2022-11-29 23:14:59","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=2573","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"inline_featured_image":["0"],"_edit_lock":["1706120192:1"],"_thumbnail_id":["4355"],"_edit_last":["1"],"profile_title":["Co-Founder","Co-Founder","Co-Founder"],"email":["dougj11@mac.com","dougj11@mac.com","dougj11@mac.com"],"company":["Big Rock Creative","Big Rock Creative","Big Rock Creative"],"linkedin":["https:\/\/www.linkedin.com\/in\/dougjacobson1\/","https:\/\/www.linkedin.com\/in\/dougjacobson1\/","https:\/\/www.linkedin.com\/in\/dougjacobson1\/"],"timezone":["-7| PDT"],"_yoast_wpseo_content_score":["90"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["1"],"no_profile_link":["0"],"twitter":["https:\/\/twitter.com\/DougJ1100"],"first_name":["Doug","Doug"],"website":["http:\/\/bigrockxr.com","http:\/\/bigrockxr.com"],"_yoast_wpseo_wordproof_timestamp":[""],"sort_name":["Jacobson, Doug"],"instagram":["https:\/\/www.instagram.com\/dougj11\/"]},"thumbnail":false,"children":[]},"7717":{"ID":7717,"title":"Athena Demos","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/athena-demos\/","slug":"athena-demos","parent":"7714","coords":"","offset":"","confirmation_status":"needs-invite","event_length_seconds":"","point_of_contact":"","guest_type":"nominee","event_type":"","appearance_type":"liveremote","notes":"","classes":[""],"post":{"ID":2569,"post_author":"1","post_date":"2022-02-03 17:33:33","post_date_gmt":"2022-02-03 17:33:33","post_content":"Athena Demos is co-founder and CEO of Big Rock Creative (BRC), an award-winning XR experience company creating groundbreaking experiences for global clients. Big Rock Creative won the Producer\u2019s Guild Award for Innovation, the Aurea Award for creativity, the No Proscenium award for Best VR experience of 2020, the Hermes' Platinum Award, and the Auggie Award for Best Societal Impact of 2022. With over 20 years of experience producing iconic events, like the LA Burning Man Decompression Arts and Music Celebration, as well as the Art of Change Inaugural Ball for President Obama in LA, she transitioned to the metaverse to produce BRCvr (Black Rock City Virtual Reality). BRCvr is an official virtual Burning Man Experience whose scope is unprecedented in the VR space. Athena produced internationally recognized social impact projects such as Breonna\u2019s Garden which premiered at SXSW 2022. She has developed a philosophical approach to guiding humanity to build a foundational fabric for creative collaboration in the metaverse. As a result, she has been quoted in leading books, articles and spoken at leading industry events.","post_title":"Athena Demos","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"athena-demos","to_ping":"","pinged":"","post_modified":"2024-01-26 16:58:26","post_modified_gmt":"2024-01-26 16:58:26","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=2569","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"inline_featured_image":["0"],"_edit_lock":["1706288526:1"],"_edit_last":["1"],"timezone":["-7| PDT"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"_thumbnail_id":["2570"],"profile_title":["Co-Founder, Producer","Co-Founder, Producer"],"email":["athena@buildpartnership.com","athena@buildpartnership.com"],"company":["Big Rock Creative","Big Rock Creative"],"website":["https:\/\/bigrockxr.com\/","https:\/\/bigrockxr.com\/"],"linkedin":["https:\/\/www.linkedin.com\/in\/athenademos\/","https:\/\/www.linkedin.com\/in\/athenademos\/"],"twitter":["https:\/\/twitter.com\/athenademos","https:\/\/twitter.com\/athenademos"],"_yoast_wpseo_content_score":["30"],"first_name":["Athena"],"discord":["auntathena#2956"],"_oembed_15cb833ac2c608faff69ed5069b34a3b":["{{unknown}}"],"sort_name":["Demos, Athena"],"_oembed_6706f30d04d8641de83ee4b50e58570d":["{{unknown}}"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"_yoast_wpseo_wordproof_timestamp":[""],"_oembed_47b1119433c7d0df5b672ce13087de52":["{{unknown}}"],"instagram":["https:\/\/www.instagram.com\/athenaaramos\/"],"_oembed_19e38f6ee16290290c41d216a4b0bb43":["{{unknown}}"],"_yoast_wpseo_primary_category":[""],"is_company":["0