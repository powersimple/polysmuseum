{"id":1598,"profile":{"ID":4770,"title":"Trent Clews-de Castella","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/trent-clews-de-castella\/","slug":"trent-clews-de-castella","parent":"4757","coords":"","offset":"","confirmation_status":"needs-invite","event_length_seconds":"","point_of_contact":"","guest_type":"nominee","event_type":"","appearance_type":"prerecorded","notes":"","classes":[""],"post":{"ID":1598,"post_author":"1","post_date":"2021-12-21 22:17:09","post_date_gmt":"2021-12-21 22:17:09","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETrent is on a mission to pioneer immersive technology and transform human experience for good.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETo achieve this, Trent believes in the power of storytelling and immersive technology to drive a new paradigm of change and climate action. Through emerging tools like VR, AR MR and WebXR, we can raise awareness for social and environmental impact causes like never before.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAs the Co-founder and CEO at PHORIA, a Melbourne-based XR Studio, Trent and his team have been Emmy nominated for their previous work in WebXR with Meta and the International Paralympics Committee. Alongside working closely with respected partners and world leaders including Netflix, Google, WWF and the United Nations (UN).\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Trent Clews-de Castella","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"trent-clews-de-castella","to_ping":"","pinged":"","post_modified":"2022-11-30 17:55:36","post_modified_gmt":"2022-11-30 17:55:36","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/?post_type=profile&#038;p=1598","menu_order":0,"post_type":"profile","post_mime_type":"","comment