{"id":2857,"profile":{"ID":3188,"title":"Corinne Brenner","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/corinne-brenner\/","slug":"corinne-brenner","parent":"2762","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2857,"post_author":"1","post_date":"2022-04-14 18:50:16","post_date_gmt":"2022-04-14 18:50:16","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ECorinne Brenner is Director of Learning at Killer Snails, where she helps create and study games that inspire a love of science. Killer Snails\u2019 most recent project is WaterWays, an augmented reality app that helps students connect the impact humans have on water, and water\u2019s impact on people. She is also a PhD candidate in NYU\u2019s Educational Communication and Technology program, where she uses a variety of methods to understand how virtual reality can be used effectively in education. \u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ECorinne is an author of numerous academic publications examining the affordances of immersive technology for education and entertainment. She received her BA in Psychology from Cornell University, and MSc in Social Psychology and Psychological Methods from the University of Amsterdam.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Corinne Brenner","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"corinne-brenner","to_ping":"","pinged":"","post_modified":"2022-11-30 16:37:36","post_modified_gmt":"2022-11-30 16:37:36","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/profile\/corinne-brenner\/","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"profile_title":["D