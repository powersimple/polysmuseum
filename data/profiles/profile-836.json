{"id":836,"profile":{"ID":992,"title":"Steve Guynup","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/steve-guynup\/","slug":"steve-guynup","parent":"970","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":836,"post_author":"1","post_date":"2021-08-30 02:33:50","post_date_gmt":"2021-08-30 02:33:50","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Guynup is an award winning VR artist, author, and teacher. As an artist, his exploration of storytelling \/ shape changing avatars and use of poetry to unpack the design language of VR in the 1990's continues to resonate today. As a professional, he built multi-million dollar training software for for CSX Rail, Weyehauser, UPS, and more. For the past decade he's taught online, in-world, multi-user, classes on VR art and design. \u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Guynup currently teaches at Southern New Hampshire University and is developing VR classes there.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Steve Guynup","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"steve-guynup","to_ping":"","pinged":"","post_modified":"2022-11-30 15:36:43","post_modified_gmt":"2022-11-30 15:36:43","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=836","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669822604:1"],"_edit_last":["1"],"timezone":["-7| PDT"],"first_name":["Steve"],"email":["steve@isovista.org"],"profile_title":["Faculty"],"company":["Southern New Hampshire University"],"website":["https:\/\/www.snhu.edu\/"],"linkedin":["https:\/\/www.linkedin.com\/in\/steveguynupworldbuilder\/"],"talk_title":["Art &amp; Educational Space"],"talk_description":["This session introduces the on-going VR Art and Design coursework of Dr. Steve Guynup. It is a live VR demo with a VR audience, broadcast from Dr. Guynup's FrameVR class space.  Teaching methods, creative use of space, and leveraging of virtual art and virtual poetry as inspiration for educational projects are explored. Participants will learn to look at their own works through a lens of virtual art and discover new options for crafting engaging educational outcomes.\r\n\r\n"],"resources":["Current Technology - FrameVR \r\nhttps:\/\/framevr.io\/\r\n\r\n\r\n"],"_thumbnail_id":["838"],"_yoast_wpseo_content_score":["90"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["0"],"no_profile_link":["0"],"sort_name":["Guynup, Steve"],"_yoast_wpseo_wordproof_timestamp":[""]},"thumbnail":false,"children":[]},"company":"Southern New Hampshire University","profile_title":"Faculty","sort":"Guynup, Steve","slug":"steve-guynup","events":[{"event_id":1018,"event_slug":"webxr-design-summit","event_key":"designsummit21","event_title":"WebXR Design Summit","session_id":840,"session_key":970,"session_title":"Art and Educational Space","session_slug":"art-and-educational-space","session_embed_video_url":"https:\/\/www.youtube.com\/embed\/Y0x0NMTZnaU?list=PLKNvd3dXSaxDJzXOTryIFUBmlCAABVR2U&index=14&autoplay=1&rel=0","session_video_url":null}]}