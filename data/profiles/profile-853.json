{"id":853,"profile":{"ID":855,"title":"Tony Parisi","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/tony-parisi\/","slug":"tony-parisi","parent":"762","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":853,"post_author":"1","post_date":"2021-09-01 14:04:07","post_date_gmt":"2021-09-01 14:04:07","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETony Parisi is a Metaverse and virtual reality pioneer, inventor, entrepreneur, investor, author and musician. He has co-created several international 3D graphics standards, including VRML, X3D, and glTF. Tony is the author of O\u2019Reilly Media\u2019s foundational books on 3D graphics and VR, Learning Virtual Reality (2015), Programming 3D Applications in HTML5 and WebGL (2014), and WebGL Up and Running (2012).\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EOne of the leading spokespeople for the immersive industry, Tony has given speeches in multiple countries about industry trends and innovation in augmented reality. He was named in Next Reality\u2019s 30 People to Watch in Augmented Reality in 2020.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETony is currently serving as Chief Strategy Officer at Lamina1, a new layer 1 blockchain for the Metaverse. He is also an advisor and limited partner in early stage venture firms including ME Ventures, a future-focused investment fund providing opportunities for creators to grow and succeed. Previously, Tony was Head of XR Ads and E-Commerce at Unity, where he oversaw strategy and product for the company\u2019s real-time 3D brand advertising and commerce solutions.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETony is also a composer and musician. He is currently finishing the cast recording for Judgment Day, a full-length original musical, and has several other music projects underway.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Tony Parisi","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"tony-parisi","to_ping":"","pinged":"","post_modified":"2022-11-29 20:46:37","post_modified_gmt":"2022-11-29 20:46:37","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=853","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669754798:1"],"_thumbnail_id":["854"],"_edit_last":["1"],"timezone":["-7| PDT"],"first_name":["Tony","Tony"],"email":["tparisi@gmail.com","tparisi@gmail.com"],"profile_title":["Chief Strategy Officer","Chief Strategy Officer"],"company":["Lamina1","Lamina1"],"website":["https:\/\/tonyparisi.medium.com\/","https:\/\/tonyparisi.medium.com\/"],"twitter":["https:\/\/twitter.com\/auradeluxe","https:\/\/twitter.com\/auradeluxe"],"linkedin":["https:\/\/www.linkedin.com\/in\/tparisi\/","https:\/\/www.linkedin.com\/in\/tparisi\/"],"resources":["f"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["1"],"no_profile_link":["0"],"_yoast_wpseo_wordproof_timestamp":[""],"_yoast_wpseo_content_score":["90"],"sort_name":["Parisi, Tony"]},"thumbnail":false,"children":[]},"company":"Lamina1","profile_title":"Chief Strategy Officer","sort":"Parisi, Tony","slug":"tony-parisi","events":[{"event_id":780,"event_slug":"webxr-business-summit","event_key":"bizsummit21","event_title":"WebXR Business Summit","session_id":408,"session_key":762,"session_title":"Success Stories and Challenges of Early Adop