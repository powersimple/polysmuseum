{"id":646,"profile":{"ID":7850,"title":"Christi Fenison","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/christi-fenison\/","slug":"christi-fenison","parent":"7384","coords":"","offset":"","confirmation_status":"needs-invite","event_length_seconds":"","point_of_contact":"ben","guest_type":"interviewee","event_type":"","appearance_type":"inperson","notes":"","classes":[""],"post":{"ID":646,"post_author":"1","post_date":"2021-08-09 19:50:05","post_date_gmt":"2021-08-09 19:50:05","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EChristi Fenison is an immersive storyteller, 3D artist, 360 videographer and simulation designer.\u003Cbr\u003EHer passion is creating XR experiences that expand perspectives and inspire action. Drawing on principles of narrative transport, cognitive elaboration and the sense of presence, she works to bring big picture ideas to life via the careful interplay of meaningful details.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EBy day, Christi works as an XR Instructional Media Producer at UNC School of Medicine IT, focused on the research, development and integration of XR training simulations in curriculum. Beyond the classroom, she is also a bespoke World Builder for Social VR events, crafting custom experiences tailored to each client\u2019s vision and goals.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EChristi received her Master's degree from the University of North Carolina at Chapel Hill\u2019s Environment and Science Communication program, where focused on Emerging Technologies, 3D Modeling + Unity Development, Green Architecture + Sustainable Design, Geospatial Information Systems, and Immersive Journalism.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Christi Fenison","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","po