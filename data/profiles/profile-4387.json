{"id":4387,"profile":{"ID":4395,"title":"Elizabeth Strickler","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/elizabeth-strickler\/","slug":"elizabeth-strickler","parent":"4119","coords":"","offset":"","confirmation_status":"complete","event_length_seconds":"","point_of_contact":"julie","guest_type":"panelist","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":4387,"post_author":"1","post_date":"2022-09-29 15:20:01","post_date_gmt":"2022-09-29 15:20:01","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EElizabeth Strickler is the Founding Director of the Creative Industries Blockchain Lab and Director of Media Entrepreneurship at Georgia State University. She teaches media innovation to undergraduate and graduate students and works with major labels and cultural icons to build web3 and blockchain\/nft strategies. Her April 2021 TEDx talk is considered canonical viewing for those entering the nft\/metaverse space and she presents regularly on the topic. She holds academic positions in both the Business School and the College of Arts and Sciences, where she has received multiple grants to research innovation and XR in education. Her goal is to help others start businesses, tell immersive stories, and build a stronger cultural economy. She believes most people can learn most things and have fun while doing so. Her eclectic interests can be seen in her academic credentials, holding a BA in Philosophy, BS in Computer Science, and an MFA in Digital Filmmaking and Art.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Elizabeth Strickler","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"elizabeth-strickler","to_ping":"","pinged":"","post_modified":"2022-11-30 17:43:01","post_modified_gmt":"2022-11-30 17:43:01","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=4387","menu_order":0