{"id":3475,"profile":{"ID":3476,"title":"William P. Levin, MD","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/william-p-levin-md\/","slug":"william-p-levin-md","parent":"3277","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":3475,"post_author":"1","post_date":"2022-06-19 18:10:18","post_date_gmt":"2022-06-19 18:10:18","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Levin is an Associate Clinical Professor and the Medical Director of Global Network Operations in the Department of Radiation Oncology at the University of Pennsylvania\u2019s Abramson Cancer Center. He received his undergraduate degree from Franklin &amp; Marshall College, a master\u2019s degree in physiology from Georgetown University, and an undergraduate medical degree from Tel Aviv University. His post-graduate training includes an internship in medicine at Yale University, a residency in radiation oncology at the University of Pennsylvania, and a fellowship in proton therapy at the Massachusetts General Hospital.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Levin\u2019s clinical focus is the management of patients with thoracic malignancies and soft tissue sarcomas. His research interests include investigation of integrative oncology modalities and mind-body medicine. Dr. Levin is a nationally and internationally recognized leader in the development of virtual reality applications for healthcare.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"William P. Levin, MD","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"william-p-levin-md","to_ping":"","pinged":"","post_modified":"2022-11-30 16:56:27","post_modified_gmt":"2022-11-30 16:56:27","post_content_filtered":"","post_parent":