{"id":2103,"profile":{"ID":2105,"title":"Mary Shelley","content":"","attr_title":"","menu_type":"resource","url":"\/resource\/mary-shelley-sci-fi-gothic-stories-and-frankenstein\/","slug":"mary-shelley-sci-fi-gothic-stories-and-frankenstein","parent":"1386","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2103,"post_author":"1","post_date":"2022-01-17 04:06:58","post_date_gmt":"2022-01-17 04:06:58","post_content":"","post_title":"Mary Shelley","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"mary-shelley-sci-fi-gothic-stories-and-frankenstein","to_ping":"","pinged":"","post_modified":"2022-02-04 20:11:38","post_modified_gmt":"2022-02-04 20:11:38","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=resource&#038;p=2103","menu_order":0,"post_type":"resource","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"resource","meta":{"_edit_lock":["1644005500:1"],"_edit_last":["1"],"resource_url":["https:\/\/www.eventbrite.com\/e\/vr-book-chat-mary-shelley-sci-fi-gothic-stories-and-frankenstein-tickets-167394709081"],"_thumbnail_id":["2104"],"inline_featured_image":["0"],"3Dlaurel_screenshots":["2626"],"3Dlaurel":["2614"],"laurel":["2279"],"_yoast_wpseo_content_score":["60"],"_yoast_wpseo_estimated-reading-time-minutes":["0"]},"thumbnail":false,"children":{"1584":{"ID":1584,"title":"Caitlin Krause","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/caitlin-krause\/","slug":"caitlin-krause","parent":"2105","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":674,"post_author":"1","post_date":"2021-08-11 18:39:02","post_date_gmt":"2021-08-11 18:39:02","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ECaitlin Krause focuses on the intersection of technology, innovation and wellbeing, and founded the studio and consultancy MindWise in 2015. She teaches about the subject at Stanford University. Caitlin has advised global organizations including Google, Facebook, Oracle, TED, Evernote, University of San Francisco, ETH Z\u00fcrich and the U.S. State Department. In September of 2020 she released the book Designing Wonder: Leading Transformative Experiences in Virtual Reality. She authored The Importance of Presence and The Art of Storytelling in VR as part of the XR Collaboration Global Resource Guide. \u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ECaitlin has created and run numerous collaborative experiences in social XR, fusing presence, mindfulness, storytelling, curiosity and emotional intelligence. A Senior Strategist for the Virtual World Society, she is a writer and designer for digital therapeutic applications that incorporate haptics and biofeedback. After two decades of teaching and leadership experience, she authored Mindful By Design (Corwin Press, 2019). Caitlin helps individuals and teams navigate complexity and change, prioritizing mindful wellbeing, joy, creativity, wonder and awe.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Caitlin Krause","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"caitlin-krause","to_ping":"","pinged":"","post_modified":"2022-11-30 15:43:42","post_modified_gmt":"2022-11-30 15:43:42","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=674","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669823024:1"],"_edit_last":["1"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"first_name":["Caitlin"],"email":["caitlin.krause@gmail.com"],"profile_title":["Immersive Design Expert"],"company":["MindWise"],"website":["https:\/\/caitlinkrause.com"],"twitter":["https:\/\/twitter.com\/mindwise_ck"],"linkedin":["https:\/\/linkedin.com\/in\/caitlinkrause\/"],"portfolio":["https:\/\/mindwise.pro"],"discord":["Caitlin Krause#7181"],"talk_title":["Wonder &amp; Awe by Design"],"resources":["Designing Wonder: Leading Transformative Experiences in VR\r\nhttps:\/\/caitlinkrause.com\/vr\/\r\n\r\nWonderland in WebXR: Lewis Carroll\\'s Logical Garden in ScienceVR\r\nhttps:\/\/hubs.sciencevr.com\/?carroll\r\n\r\n\r\n"],"_thumbnail_id":["680"],"_yoast_wpseo_content_score":["90"],"timezone":["-7| PDT"],"talk_description":["A conversation about how we can reframe for immersive creativity through invoking awe and wonder. This talk brings up design considerations, intentional choices, and examples of ways that prioritizing a sense of wonder leads to WebXR experiences aligned with flow and flourishing, creative expression, wellbeing and connection.  "],"inline_featured_image":["0"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["0"],"no_profile_link":["0"],"sort_name":["Krause, Caitlin"],"3Dlaurel_screenshots":["2622"],"3Dlaurel":["2614","2526"],"laurel":["2198","2279"],"_yoast_wpseo_wordproof_timestamp":[""],"instagram":["https:\/\/www.instagram.com\/caitlinkrause_ck\/"]},"thumbnail":false,"children":[]},"2111":{"ID":2111,"title":"ScienceVR","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/sciencevr\/","slug":"sciencevr","parent":"2105","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":1537,"post_author":"1","post_date":"2021-12-19 19:07:37","post_date_gmt":"2021-12-19 19