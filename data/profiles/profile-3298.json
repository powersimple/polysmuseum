{"id":3298,"profile":{"ID":3299,"title":"Aleshia Hayes","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/aleshia-hayes\/","slug":"aleshia-hayes","parent":"2772","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":3298,"post_author":"1","post_date":"2022-04-18 16:42:51","post_date_gmt":"2022-04-18 16:42:51","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Hayes is passionate about developing, evaluating, and iterating on technology used for learning in formal and informal environments. She has designed and created educational XR experiences over the past decade and works tirelessly to encourage students at all levels to pursue STEM education and STEM careers with the explicit goal of expanding and diversifying STEM education and the STEM workforce. Her efforts to recruit students into STEM range from public exhibits of Virtual Reality, to K12 classroom visits, to app development camps for middle and high school-aged students to hosting interdisciplinary game development events.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EDr. Hayes leverages her research funded by NSF, NIH, the Department of Defense and the Bill and Melinda Gates Foundation to inform Learning Technology design and implementation across learners from K12 and university levels to the workforce.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Aleshia Hayes","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"aleshia-hayes","to_ping":"","pinged":"","post_modified":"2022-11-29 22:01:27","post_modified_gmt":"2022-11-29 22:01:27","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/?post_type=profile&#038;p=3298","menu_order":0,"post_type":"profile","post_mime_type":"","