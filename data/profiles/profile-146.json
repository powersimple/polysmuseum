{"id":146,"profile":{"ID":7335,"title":"Sophia Moshasha","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/sophia-moshasha\/","slug":"sophia-moshasha","parent":"7304","coords":"","offset":"","confirmation_status":"team","event_length_seconds":"","point_of_contact":"","guest_type":"host","event_type":"","appearance_type":"inperson","notes":"","classes":[""],"post":{"ID":146,"post_author":"1","post_date":"2021-07-17 23:59:30","post_date_gmt":"2021-07-17 23:59:30","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ESophia Moshasha is on a mission to accelerate the adoption of immersive &amp; emerging technologies. Behind the scenes, on camera, and on stage, Sophia is a driving force behind numerous initiatives designed to advance knowledge and engagement with XR across all sectors.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAs a producer of The Polys - WebXR Awards and host of its Virtual Red Carpet, Special Correspondent of the WebXR Summit Series and co-host of the VRARA podcast, Sophia has interviewed dozens of XR pioneers and innovators. As a fellow of MetaTr@versal, an initiative to advocate for cooperation among the stakeholders of the Metaverse on standards and interoperability, Sophia was the star of a 40 minute, 3-act play which was performed live on the Main Stage at AWE 2022, which featured a cast of industry heavyweights. She is a co-founder of XR Women, a global collective dedicated to the advancement of female representation in technology.&nbsp; Sophia will host the WebXR Brand Summit on September 15.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ESince 2018, Sophia has been the Vice President of the DC Chapter of the VR\/AR Association\u2019s Washington, D.C. Chapter. Sophia is also the co-founder and Chief Marketing Officer for Ready Player Golf, the first annual Virtual Reality Charity Golf Outing, which began in 2020, and has raised money for MSF (Doctors Without Borders) and XRSI (the XR Safety Initiative). She has served as Head of Partnerships for Brightline Interactive, XR Strategist for Virtual Reality Marketing, and in Executive Program support for AFWERX, the US Air Force\u2019s Innovation Investment Program.&nbsp;\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003Cbr\u003ESophia has been influencing global networks through many years of active engagement in the XR community. She has been featured on prominent media outlets such as Forbes, ABC, CGTN, American Dream TV series and more She holds a Bachelor of Science from Virginia Commonwealth University. She is currently engaged in public policy planning for Meta.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Sophia Moshasha","post_excerpt":"Sophia is host of The Polys Red Carpet,the WebXR Brand Summit, Special Correspondent of WebXR Summit Series, Co-Founder of XR Women and Ready Player Golf, VP of the DC Chapter of VRARA, and co-host of the VRARA Podcast.","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"sophia-moshasha","to_ping":"","pinged":"","post_modified":"2023-09-11 19:29:31","post_modified_gmt":"2023-09-11 19:29:31","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/?post_type=profile&#038;p=146","menu_order":19,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1694462678:1"],"_thumbnail_id":["5559"],"_edit_last":["1"],"linkedin":["https:\/\/www.linkedin.com\/in\/sophiamoshasha\/"],"profile_title":["Host","Host"],"company":["The Polys Red Carpet","The Polys Red Carpet"],"email":["sophia.moshasha@gmail.com"],"timezone":["-7| PDT"],"_yoast_wpseo_content_score":["30"],"_yoast_wpseo_estimated-reading-time-minutes":["2"],"utc_start":["0"],"session_type":["panel"],"suppress_profile_page":["0