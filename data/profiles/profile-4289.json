{"id":4289,"profile":{"ID":7536,"title":"Kiira Benzing","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/kiira-benzing\/","slug":"kiira-benzing","parent":"7392","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":4289,"post_author":"1","post_date":"2022-09-10 14:29:55","post_date_gmt":"2022-09-10 14:29:55","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EKiira is a multi-dimensional director crossing the mediums of theatre, hybrid cinema and virtual reality. VR credits include: Cardboard City which won the Samsung Gear VR contest (2016) and premiered at the NYFF in 2016. For her interactive VR experience Runnin\u2019 starring Reggie Watts, she was the first VR director to film on the Intel Studios volumetric capture stage (Sundance 2019, Jury Award for Interactive at SXSW 2019). Loveseat, (VR Theatre - Venice Film Festival 2019) was performed simultaneously before live and virtual audiences. Her latest VR Theatre production Finding Pandora X featured Broadway actors and was recently performed virtually at the Venice Film Festival 2020. She is the founder of Double Eye Studios which specializes in VR Theatre, live events and virtual production.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Kiira Benzing","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"kiira-benzing","to_ping":"","pinged":"","post_modified":"2024-04-13 13:39:33","post_modified_gmt":"2024-04-13 13:39:33","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=4289","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1713015575:1"],"_edit_last":["1"],"profile_title":["Director; Producer","Director; Producer"],"email