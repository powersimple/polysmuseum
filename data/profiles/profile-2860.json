{"id":2860,"profile":{"ID":3393,"title":"Emily Sherwood","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/emily-sherwood\/","slug":"emily-sherwood","parent":"2823","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2860,"post_author":"1","post_date":"2022-04-14 18:50:16","post_date_gmt":"2022-04-14 18:50:16","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EEmily Sherwood is Director of Digital Scholarship and Studio X at University of Rochester\u2019s River Campus Libraries. She is an alum of both the Council on Libraries and Information Resources (CLIR) Postdoctoral Fellowship Program and the EDUCAUSE\/CLIR Leading Change Institute. With over a decade of experience helping faculty across disciplines incorporate technology in their teaching and research, Emily regularly collaborates with faculty, staff, and administrators at UR and beyond to develop experiential learning opportunities, increase digital literacy skills, and push the boundaries of how libraries support research and teaching through the use of technology. \u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ECurrently, she is building capacity for augmented and virtual reality at UR with the opening of Studio X, a hub for immersive technologies. Emily holds a doctorate in English from the Graduate Center of the City University of New York.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Emily Sherwood","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"emily-sherwood","to_ping":"","pinged":"","post_modified":"2022-11-30 16:52:10","post_modified_gmt":"2022-11-30 16:52:10","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/profile\/emily-sherwood\/","menu_order":0,"post_type"