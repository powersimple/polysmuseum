{"id":3294,"profile":{"ID":3296,"title":"Heather Dodds","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/heather-dodds\/","slug":"heather-dodds","parent":"2772","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":["moderator"],"post":{"ID":3294,"post_author":"1","post_date":"2022-04-18 16:38:14","post_date_gmt":"2022-04-18 16:38:14","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EHeather Elizabeth Dodds, Ph.D. is a compassionate and enthusiastic research design advocate. She has current UX certifications and holds a Master\u2019s Degree in e-Education from the University of Phoenix and a Doctorate in Instructional Design for Online Learning from Capella University. Heather\\'s 2013 dissertation is on the quantitative effects of virtual worlds (Second Life) on scientific inquiry skills. \u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EIn the past two years, Heather has authored two book chapters, one on the use of XR in STEM education and one for instructional designers guiding the use of XR in higher education. Recently, she also taught one of the first college courses ever to incorporate the Quest 2 headset. She actively publishes about the design and use of XR for learning via LinkedIn and her blog.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Heather Dodds","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"heather-dodds","to_ping":"","pinged":"","post_modified":"2022-11-30 16:53:19","post_modified_gmt":"2022-11-30 16:53:19","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/?post_type=profile&#038;p=3294","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["16