2-11-30 17:48:12","post_modified_gmt":"2022-11-30 17:48:12","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=2064","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669830493:1"],"_edit_last":["1"],"website":["http:\/\/deep-inc.com\/","http:\/\/deep-inc.com\/"],"linkedin":["https:\/\/www.linkedin.com\/in\/deepinc\/"],"timezone":["-7| PDT"],"_thumbnail_id":["4496"],"inline_featured_image":["0"],"email":["thomas@liquidcinemavr.com","thomas@liquidcinemavr.com"],"utc_start":["0"],"session_type":["panel"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["1"],"no_profile_link":["0"],"_yoast_wpseo_wordproof_timestamp":[""],"first_name":["Thomas"],"profile_title":["Founder"],"company":["Liquid Cinema Inc."],"_yoast_wpseo_content_score":["60"],"sort_name":["Wallner, Thomas"]},"thumbnail":false,"children":[]},"2469":{"ID":2469,"title":"John Collins","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/john-collins\/","slug":"john-collins","parent":"2702","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2465,"post_author":"1","post_date":"2022-01-27 16:10:29","post_date_gmt":"2022-01-27 16:10:29","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EJohn Collins a.k.a. The Paper Airplane Guy held the world record holder for paper airplane distance for ten years. Author of five books of original designs, John has been called the world\u2019s foremost expert on paper aircraft. He has appeared on Conan, Nat Geo, Discovery, Science Channel, ESPN\u2019s Sports Science, Ripley\u2019s Believe It or Not, as well as performing live for TedX Munich, Google Zeitgeist, WIRED 21, Harvard\u2019s Graduate School of Design, and more than 90 in-person presentations per year.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EIf you've never seen a paper airplane flaps it's wings, flip over and fly back upside down, spin, circle, loop or stay aloft for minutes indoors; tighten your seat belt and stow your tray table. You\u2019re cleared for takeoff!\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"John Collins","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"john-collins","to_ping":"","pinged":"","post_modified":"2022-11-30 17:28:08","post_modified_gmt":"2022-11-30 17:28:08","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=2465","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"inline_featured_image":["0"],"_edit_lock":["1669829456:1"],"_thumbnail_id":["3549"],"_edit_last":["1"],"profile_title":["The Paper Airplane Guy","The Paper Airplane Guy"],"email":["johncollins@sonic.net","johncollins@sonic.net"],"linkedin":["https:\/\/www.linkedin.com\/in\/john-collins-39163120\/","https:\/\/www.linkedin.com\/in\/john-collins-39163120\/"],"twitter":["https:\/\/twitter.com\/pprairplnguy","https:\/\/twitter.com\/pprairplnguy"],"timezone":["-7| PDT"],"_yoast_wpseo_content_score":["60"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"first_name":["John"],"website":["http:\/\/www.thepaperairplaneguy.com"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"registration_pending":["0"],"request_profile_update":["0"],"no_profile_link":["0"],"sort_name":["Collins, John"],"_yoast_wpseo_wordproof_timestamp":[""],"instagram":["https:\/\/www.instagram.com\/thepaperairplaneguy\/"]},"thumbnail":false,"children":[]},"2341":{"ID":2341,"title":"Haggai Goldfarb","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/haggai-goldfarb-2\/","slug":"haggai-goldfarb-2","parent":"2702","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2063,"post_author":"1","post_date":"2022-01-16 23:17:13","post_date_gmt":"2022-01-16 23:17:13","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EHaggai Goldfarb, has held leadership positions with a distinguished track record of delivering successful large-scale projects and products to market. For over a decade he led VFX teams in Hollywood with significant roles at Warner Bros. Disney, DreamQuest and DreamWorks. Notable awards include: The recent prestigious Polys WebXR Awards 2021 with 3 wins for Experience of the year, Education experience of the year, and Video experience of the year for \u2018The Magic of Flight\u2019 XR experience, AIXR VR Awards 2021 nomination, DreamWorks Achievement Award, Kung-Fu Panda\u2019s 2008 Academy Award Nomination for Best Animated Feature of the year, as well as winning the 36th Annual Annie Awards in 10 categories, including Best Animated Feature, \u2018The High Ground Award\u2019 strategy war games, between M.I.T Sloan Fellows and Harvard Business School, and has served as judge for the Animation Oscars. A visionary, inventor and a Metaverse pioneer, Haggai pursuit of the Metaverse and related Extended Reality (XR) and Enhanced Reality (ER) technologies (e.g 3D,VFX, AR,VR, MR) span over 20 years. At DreamWorks he managed key innovation, development and integration of the Academy award-winning \"Shrek\" facial system, adapting it to DreamWorks' animated features franchise pipeline. By enabling animators to convey emotions through facial expressions as never before, the Shrek facial system, was the breakthrough that allowed Shrek to be the first computer- animated film ever to put digital human characters in leading roles, leading it to become the highest- grossing animated franchise of all times, with over $3.5B in revenues. In 2006, Haggai launched a tech startup out of M.I.T focused on the innovation of the next generation natural human interface for the Metaverse. His innovation lab created key technologies and XR experiences that preceded commercial VR headsets including avatar interaction, head, facial and eye tracking, gestural and haptic. At Microsoft Haggai led Mixed Reality (MR) initiatives and R&amp;D prototyping on HoloLens including the first shareable HoloLens Mixed Reality experience development at Microsoft which preceded \u201cMesh\u201d. Most recently Haggai led XR strategy at Meta driving global XR initiatives, partnerships and teams in NA, APAC and EMEA. Notably, he produced and oversaw the creation and deployment for the first WebXR\/OpenXR project, Project Origami: \u201cThe Magic of Flight\u201d. As an innovation leader, he operates at the intersection of business, technology and creative. Haggai is an Alfred Sloan Fellow receiving his MBA from the MIT Sloan School of Management.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Haggai Goldfarb","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"haggai-goldfarb-2","to_ping":"","pinged":"","post_modified":"2022-11-30 17:54:56","post_modified_gmt":"2022-11-30 17:54:56","post_content_filtered":"","post_parent":0,"guid":"https:\/\/thepolys.com\/?post_type=profile&#038;p=2063","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669830898:1"],"_edit_last":["1"],"timezone":["-7| PDT"],"linkedin":["https:\/\/www.linkedin.com\/in\/haggaigoldfarb\/","https:\/\/www.linkedin.com\/in\/haggaigoldfarb\/"],"twitter":["https:\/\/twitter.com\/haggai"],"_thumbnail_id":["4448"],"inline_featured_image":["0"],"_yoast_wpseo_content_score":["30"],"_yoast_wpseo_estimated-reading-time-minutes":["2"],"email":["haggaigoldfarb@gmail.com","haggaigoldfarb@gmail.com"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["1"],"no_profile_link":["0"],"first_name":["Haggai"],"profile_title":["XR Strategy and Innovation Leader"],"resources":["I\\'m always on the look for the latest and greatest at the forefront of emerging technologies, such as in XR and the Metaverse. If you are trying to reach me for some exciting project (or anything else) please send me a message on my LinkedIn or here: https:\/\/the-secret-lab.business.site\/ and I\\'ll try to get back to you as soon as I can\r\n "],"_yoast_wpseo_wordproof_timestamp":[""],"sort_name":["Goldfarb, Haggai"],"instagram":["https:\/\/www.instagram.com\/haggaigoldfarb\/"]},"thumbnail":false,"children":[]}}}}},"company":"","profile_title":"","sort":null,"slug":"the-magic-of-flight","events":[{"event_id":2515,"event_slug":"the-2nd-polys-ceremony","event_key":"polys2","event_title":"The 2nd Polys Ceremony","session_id":1340,"session_key":1625,"session_title":"2021 \u2013 Video Experience of the Year","session_slug":"veoty-2021","session_embed_video_url":"https:\/\/www.youtube.com\/embed\/1V0pEX3THFA?list=PLaJh3dINT2l-pIpPTkcdYWefiz4P31L9K&index=6&autoplay=1&rel=0","session_video_url":null},{"event_id":2515,"event_slug":"the-2nd-polys-ceremony","event_key":"polys2","event_title":"The 2nd Polys Ceremony","session_id":1336,"session_key":1391,"session_title":"2021 \u2013 Education Experience of the Year","session_slug":"edoty-2021","session_embed_video_url":null,"session_video_url":null},{"event_id":2515,"event_slug":"the-2nd-polys-ceremony","event_key":"polys2