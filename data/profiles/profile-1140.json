{"id":1140,"profile":{"ID":2678,"title":"Yinch Yeap","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/yinch-yeap\/","slug":"yinch-yeap","parent":"5044","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":1140,"post_author":"1","post_date":"2021-09-30 22:23:31","post_date_gmt":"2021-09-30 22:23:31","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EYinch is a software engineer who works in the games and real time graphics space. His recent projects have included a VR ski fitness game, a jetliner cockpit procedural trainer and MRI machine simulator. He believes that technology should help solve real world problems and make life better.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EHe works closely with local schools to give access to immersive, interactive and inspiring VR learning experiences, ranging from an ISS jetpack adventure to Shakespeare\\'s Globe Theatre. His company also runs programmes that encourage pupils to learn coding skills.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EBefore VR, his company has worked on video installations, healthcare mobile apps, treadmill fitness software and interactive 3D kiosks. Clients including Bank of America, Ford Motor Company and Samsung USA.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EYinch founded playko after working as lead developer on console games and multimedia titles. He graduated with a Masters in Engineering from Imperial College, London.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Yinch Yeap","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"yinch-yeap","to_ping":"","pinged":"","post_modified"