{"id":2892,"profile":{"ID":3197,"title":"Michael McDonald","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/michael-mcdonald\/","slug":"michael-mcdonald","parent":"2824","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":2892,"post_author":"1","post_date":"2022-04-14 18:50:17","post_date_gmt":"2022-04-14 18:50:17","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAfter a combined 20 years of studying and teaching foreign languages, Michael McDonald created Gold Lotus which aims to demonstrate how virtual reality can support the learning and teaching of foreign languages.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ERecent projects include the launch of the Handy English VR vocabulary-building app, a 24-hour VR English lesson and cultural event to raise funds for the fight against Covid and programs in schools around the world aimed at raising awareness of how VR can be used to develop language skills and cultural awareness, with particular focus on students building their own webXR spaces to share their local cultural heritage in a unique VR exchange program. His most recent course in partnership with VictoryXR has just concluded on the ENGAGE VR platform - Public Speaking in a Multicultural World.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Michael McDonald","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"michael-mcdonald","to_ping":"","pinged":"","post_modified":"2022-11-30 16:48:16","post_modified_gmt":"2022-11-30 16:48:16","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxrsummitseries\/profile\/michael-mcdonald\/","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta