{"id":1094,"profile":{"ID":1097,"title":"Alex Harvey","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/alex-harvey\/","slug":"alex-harvey","parent":"968","coords":"","offset":"","confirmation_status":"","event_length_seconds":"","point_of_contact":"","guest_type":"","event_type":"","appearance_type":"","notes":"","classes":[""],"post":{"ID":1094,"post_author":"1","post_date":"2021-09-29 11:58:34","post_date_gmt":"2021-09-29 11:58:34","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAlex spent 10 years in the games industry with Codemasters before starting RiVR in 2015.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EWe started making 360 videos for car manufacturers and holiday brands all around the world which led us to create some software to synchronise all the virtual reality headset together. RiVR link is the software that came out of those projects and is now being used all over the world for training in all industries particularly first responders.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ERiVR has also created photo realistic fire and crime scene investigation scenarios (RiVR investigate) for UK and US governments and we now see the software being used in multiple sectors.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003Eas we look to the future we are growing our scanning techniques and pipelines allowing us to create two-dimensional documentary series which incorporates 6\u00b0 of freedom photorealistic room scale virtual reality as well!\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EStep inside is the new platform we are creating to allow people to go that next step with a documentary film or TV series.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Alex Harvey","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"alex-harvey","to_ping":"","pinged":"","post_modified":"2022-11-30 15:19:47","post_modified_gmt":"2022-11-30 15:19:47","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=1094","menu_order":0,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1669821589:1"],"_edit_last":["1"],"timezone":["-7| PDT"],"_yoast_wpseo_estimated-reading-time-minutes":["1"],"_thumbnail_id":["1095"],"_yoast_wpseo_content_score":["60"],"first_name":["Alex"],"email":["alex.harvey@RiVR.uk"],"profile_title":["CEO \/ Creative Director"],"company":["RiVR"],"website":["http:\/\/www.rivr.uk"],"resources":["https:\/\/youtu.be\/02ynEyvrlAM"],"linkedin":["https:\/\/www.linkedin.com\/in\/alextenchrivr\/"],"twitter":["https:\/\/twitter.com\/AlexTench"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["0"],"no_profile_link":["0"],"sort_name":["Harvey, Alex"],"_yoast_wpseo_wordproof_timestamp":[""]},"thumbnail":false,"children":[]},"company":"RiVR","profile_title":"CEO \/ Creative Director","sort":"Harvey, Alex","slug":"alex-harvey","events":[{"event_id":1018,"event_slug":"webxr-design-summit","event_key":"designsummit21","event_title":"WebXR Design Summit","session_id":495,"session_key":968,"session_title":"Why 6DoF Matters","session_slug":"6dof-and-slam","session_embed_video_url":"https:\/\/www.youtube.com\/embed\/YRI9qarvAmY?list=PLKNvd3dXSaxDJzXOTryIFUBmlCAABVR2U&index=5&autoplay=1&rel=0","session_video_url":null}]}