{"id":615,"profile":{"ID":7763,"title":"Joanna Popper","content":"","attr_title":"","menu_type":"profile","url":"\/profile\/joanna-popper\/","slug":"joanna-popper","parent":"7494","coords":"","offset":"","confirmation_status":"prerecord-edit-complete","event_length_seconds":"","point_of_contact":"","guest_type":"award-presenter","event_type":"","appearance_type":"prerecorded","notes":"","classes":["presenter"],"post":{"ID":615,"post_author":"1","post_date":"2021-08-05 15:46:56","post_date_gmt":"2021-08-05 15:46:56","post_content":"\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EJoanna Popper is an award-winning Hollywood and Silicon Valley media executive with a track record of launching cutting edge content and technology to drive revenue, audience engagement and brand love.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EShe currently leads HP\u2019s Virtual Reality initiatives for Go-To-Market and Location Based Entertainment. Prior she was EVP of Media &amp; Marketing at Singularity University and VP Marketing at NBCUniversal.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EJoanna is Executive Producer on \u201cBreonna\u2019s Garden\u201d which premiered at the Tribeca Festival. This augmented reality experience was created by Lady PhoEnix and Sutu with Ju\u2019Niyah Palmer to honor the life of her sister, Breonna Taylor.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EJoanna was Executive Producer on Double Eye Studios\u2019 \u201cFinding Pandora X,\u201d winner of Venice Film Festival Golden Lion for Best VR Experience and the SXSW Audience Award for Virtual Cinema Spotlight. Finding Pandora X is a modern day take on Greek mythology live interactive experience in VRChat.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EJoanna was selected as \u201c50 Women Can Change the World in Media and Entertainment,\u201d \u201cTop 50 Original Thinkers in VR,\u201d \u201cTop Women in Media: Game Changers,\u201d \u201cTop Women in Media: Industry Leaders,\u201d \u201cDigital It List,\u201d \u201c101 Women Leading the VR Industry\u201d and is on the Coalition for the Women in XR Fund.\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003C\/p\u003E\n\u003C!-- \/wp:paragraph --\u003E","post_title":"Joanna Popper","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"joanna-popper","to_ping":"","pinged":"","post_modified":"2024-03-24 19:35:07","post_modified_gmt":"2024-03-24 19:35:07","post_content_filtered":"","post_parent":0,"guid":"https:\/\/webxr.events\/?post_type=profile&#038;p=615","menu_order":7,"post_type":"profile","post_mime_type":"","comment_count":"0","filter":"raw"},"post_type":"profile","meta":{"_edit_lock":["1711309009:1"],"_edit_last":["1"],"_yoast_wpseo_estimated-reading-time-minutes":["2"],"email":["joanna.popper@gmail.com","joanna.popper@gmail.com"],"profile_title":["Global Head of VR, Go-to-Market","Global Head of VR, Go-to-Market"],"company":["HP","HP"],"website":["https:\/\/HP.com","https:\/\/HP.com"],"twitter":["https:\/\/twitter.com\/joannapopper","https:\/\/twitter.com\/joannapopper"],"linkedin":["https:\/\/www.linkedin.com\/in\/joannapopper\/","https:\/\/www.linkedin.com\/in\/joannapopper\/"],"resources":["www.hp.com\/go\/VR \r\nwww.hp.com\/Reverb \r\nwww.hp.com\/Omnicept \r\nwww.hp.io\/Omnicept ","www.hp.com\/go\/VR \r\nwww.hp.com\/Reverb \r\nwww.hp.com\/Omnicept \r\nwww.hp.io\/Omnicept "],"_thumbnail_id":["636"],"_yoast_wpseo_content_score":["60"],"timezone":["-7| PDT"],"suppress_profile_page":["0"],"PhD":["0"],"use_aframe":["0"],"registration_pending":["0"],"invitation_sent":["0"],"calendar_sent":["0"],"calendar_confirmed":["0"],"signed_release":["0"],"request_profile_update":["0"],"no_profile